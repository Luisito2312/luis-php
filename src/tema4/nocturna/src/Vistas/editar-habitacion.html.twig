<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hotel Nocturna - Editar Habitación</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/Libreria/nocturna.css" rel="stylesheet" />
</head>
<body>

  <!-- Menú Superior -->
  <nav class="navbar navbar-expand-lg navbar-dark navbar-nocturna py-3">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center gap-2" href="index.php">
        <i class="bi bi-moon-stars-fill text-danger"></i>
        NOCTURNA
      </a>
    </div>
  </nav>

  <!-- Contenedor del Formulario -->
  <main class="container my-5" style="max-width: 650px;">
    <div class="card card-nocturna shadow-lg border-secondary">
      <div class="card-header bg-black bg-opacity-25 py-3 border-secondary">
        <h2 class="h4 mb-0 text-light">Editar Habitación #{{ habitacion.numero }}</h2>
      </div>

      <div class="card-body p-4">
        <form action="index.php?accion=actualizar" method="POST">
          
          <!-- Campo oculto: imprescindible para saber cuál actualizar -->
          <input type="hidden" name="idHabitacion" value="{{ habitacion.idHabitacion }}">

          <div class="mb-3">
            <label for="numero" class="form-label">Número de Habitación</label>
            <input type="number" class="form-control" id="numero" name="numero" value="{{ habitacion.numero }}" required>
          </div>

          <div class="mb-3">
            <label for="nombre" class="form-label">Nombre / Tipo</label>
            <input type="text" class="form-control" id="nombre" name="nombre" value="{{ habitacion.nombre }}" required>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="capacidad" class="form-label">Capacidad (huéspedes)</label>
              <input type="number" class="form-control" id="capacidad" name="capacidad" value="{{ habitacion.capacidad }}" min="1" required>
            </div>

            <div class="col-md-6 mb-3">
              <label for="precio" class="form-label">Precio por noche (€)</label>
              <input type="number" step="0.01" class="form-control" id="precio" name="precio" value="{{ habitacion.precio }}" min="0" required>
            </div>
          </div>

          <div class="mb-4">
            <label for="estado" class="form-label">Estado actual</label>
            <select class="form-select" id="estado" name="estado">
              <option value="1" {{ habitacion.estado.value == 1 ? 'selected' : '' }}>Disponible (Libre)</option>
              <option value="0" {{ habitacion.estado.value == 0 ? 'selected' : '' }}>Ocupada (Reservada)</option>
            </select>
          </div>

          <div class="d-flex justify-content-between">
            <a href="index.php" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-primary">Guardar Cambios</button>
          </div>

        </form>
      </div>
    </div>
  </main>

</body>
</html>