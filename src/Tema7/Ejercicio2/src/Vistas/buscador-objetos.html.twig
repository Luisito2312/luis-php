<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Oficina Municipal de Objetos Perdidos</title>
    <style>
        body { font-family: Arial, sans-serif; max-width: 900px; margin: 2rem auto; padding: 0 1rem; color: #333; }
        .formularios { display: flex; gap: 2rem; flex-wrap: wrap; margin-bottom: 2rem; }
        form { flex: 1; min-width: 280px; padding: 1.2rem; border: 1px solid #ccc; border-radius: 6px; background: #f9f9f9; }
        label { display: block; font-weight: bold; margin-bottom: 0.5rem; }
        input[type="number"], input[type="text"] { width: 100%; padding: 0.5rem; margin-bottom: 1rem; box-sizing: border-box; }
        button { padding: 0.6rem 1.2rem; background: #0056b3; color: white; border: none; border-radius: 4px; cursor: pointer; }
        button:hover { background: #004494; }
        table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
        th, td { border: 1px solid #ddd; padding: 0.75rem; text-align: left; }
        th { background-color: #0056b3; color: white; }
        tr:nth-child(even) { background-color: #f2f2f2; }
        .alerta-error { padding: 1rem; background: #ffe6e6; border-left: 4px solid #cc0000; color: #990000; margin-bottom: 1rem; }
        .mensaje-info { padding: 1rem; background: #eef6fc; border-left: 4px solid #0056b3; }
    </style>
</head>
<body>

    <h1>Oficina Municipal de Objetos Perdidos</h1>

    <div class="formularios">
        <!-- Formulario 1: Búsqueda por identificador -->
        <form method="POST" action="index.php">
            <h3>Buscar por Identificador</h3>
            <input type="hidden" name="accion" value="buscar_id">
            <label for="identificador">Identificador del objeto:</label>
            <input type="number" id="identificador" name="identificador" min="1" value="{{ tipoBusqueda == 'id' ? ultimoId : '' }}" required>
            <button type="submit">Buscar por ID</button>
        </form>

        <!-- Formulario 2: Búsqueda por texto -->
        <form method="POST" action="index.php">
            <h3>Buscar por Nombre o Descripción</h3>
            <input type="hidden" name="accion" value="buscar_texto">
            <label for="texto">Texto a buscar:</label>
            <input type="text" id="texto" name="texto" value="{{ tipoBusqueda == 'texto' ? ultimoTexto : '' }}" required>
            <button type="submit">Buscar por Texto</button>
        </form>
    </div>

    {% if error %}
        <div class="alerta-error">
            {{ error }}
        </div>
    {% endif %}

    {% if busquedaRealizada %}
        <h2>Resultados de la búsqueda</h2>

        {% if objetos is not empty %}
            <p>Número de objetos encontrados: <strong>{{ objetos|length }}</strong></p>
            <table>
                <thead>
                    <tr>
                        <th>Identificador</th>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Lugar</th>
                        <th>Fecha de recogida</th>
                    </tr>
                </thead>
                <tbody>
                    {% for objeto in objetos %}
                        <tr>
                            <td>{{ objeto.identificador }}</td>
                            <td>{{ objeto.nombre }}</td>
                            <td>{{ objeto.descripcion }}</td>
                            <td>{{ objeto.lugar }}</td>
                            <td>{{ objeto.fecha }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <div class="mensaje-info">
                No se ha encontrado ninguna coincidencia con los criterios introducidos.
            </div>
        {% endif %}
    {% endif %}

</body>
</html>